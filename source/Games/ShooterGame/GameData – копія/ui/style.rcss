

/* =========================
   Header
   ========================= */
h1 {
    margin: 0 0 3vh 0;
    font-size: 8vh;
    color: #cfa23a; /* old gold */
    font-effect: glow(2px 4px 2px 3px rgb(90, 20, 20));
}

p {
    margin: 2vh 0 4vh 0;
    font-size: 3.2vh;
    color: transparent;
    font-effect: blur(10vh #f5eaea);
}

label {
    margin: 3vh 0 1vh 0;
    font-size: 3.2vh;
    color: #d2bebe; /* ash */
}

/* =========================
   INPUT (GOTHIC RED)
   ========================= */
input[type="text"] {
    width: 80vh;
    max-width: 80vh;
    padding: 0px 0px;
    line-height: 1.4;
    font-size: 6vh;

    background-color: #241414; /* dark blood steel */
    color: #d1c6c6;

    box-sizing: border-box;
    box-shadow: 0px 2px 6px #050000;
}

input[type="text"]::placeholder {
    color: #8f6b6b;        /* muted ash-red */
    font-style: italic;   /* optional */
}


input[type="text"]:focus {
    border-color: #c0392b;
    font-effect: shadow(2px 2px #160000);
    tab-index: auto;
}



/* =========================
   Button
   ========================= */
button {
    padding: 0.5vh 1.5vh;
    font-size: 3vh;

    background-color: #4a1515; /* dried blood */
    color: #d1c6c6;

    border-radius: 0.2vh;
    border-color: #1f0000;
    cursor: pointer;

    border-width: 0.25vh;

    box-shadow: 0 0.5vh 1vh #050000;
    font-effect: shadow(0.2vh 0.2vh #120000);
    tab-index: auto;
    font-size: 4.0vh;

    display: inline-block;
    text-align: center;
    white-space: nowrap;

    margin: 0.1vh;

}

button:active {
    border-color: #cfa23a;
    box-shadow: 0px 2px 6px #050000;
}


/* =========================
   SELECT - GOTHIC RED 
   ========================= */

select {
    display: inline-block;
    vertical-align: middle;
    width: 30vh;
    height: 7vh;
    font-size: 4.0vh;
    background-color: #241414;
    color: #d1c6c6;
    box-sizing: border-box;
    border-radius: 0.2vh;
    border-width: 0.25vh;
    
    border-color: #1f0000;
    box-shadow: 0px 2px 6px #050000;
    font-effect: shadow(0.2vh 0.2vh #120000);
    padding: 0;
    margin: 0;

    cursor: pointer;
    overflow: visible;              /* Prevent border clipping */
    position: relative;
}

/* Hide any extra internal elements (arrows, buttons, etc.) but keep selectvalue and selectbox */
select > *:not(selectvalue):not(selectbox) {
    display: none;
}

/* Selected value – fills the content area exactly */
select selectvalue {
    display: block;
    height: 100%;
    width: 100%;
    padding: 0 2vh;
    box-sizing: border-box;
    color: #d1c6c6;
    line-height: 7vh;                /* Match select height */
    text-align: center;
    background-color: #00000000; 
    overflow: hidden;
}

/* Dropdown list – matches select width */
select selectbox {
    width: 100%;
    margin-left: 0;
    padding: 0.5vh 0;
    background-color: #241414;
    border-radius: 0.2vh;
    border-width: 0.25vh;
    
    border-color: #1f0000;
    box-shadow: 0px 4px 12px #050000;
    box-sizing: border-box;
}

/* Options */
select selectbox option {
    display: block;
    width: 100%;
    height: 5.5vh;
    line-height: 5.5vh;
    padding: 0 2vh;
    background-color: #241414;
    color: #d1c6c6;
    font-size: 4.0vh;
    text-align: center;
    box-sizing: border-box;
}

select selectbox option:hover {
    background-color: #3a1f1f;
}

select selectbox option:checked {
    background-color: #c0392b;
    color: #fff;
}

/* Scrollbar – unchanged */
select selectbox scrollbarvertical {
    width: 1.5vh;
    background-color: transparent;
}

select selectbox scrollbarvertical slidertrack {
    background-color: #241414;
}

select selectbox scrollbarvertical sliderbar {
    background-color: #c0392b;
    border-radius: 0.2vh;
}

select selectbox scrollbarvertical sliderbar:hover {
    background-color: #d1c6c6;
}

select selectbox scrollbarvertical sliderarrowdec,
select selectbox scrollbarvertical sliderarrowinc {
    display: none;
}

/* =========================
   CHECKBOX + LABEL (GOTHIC RED - ALIGNED)
   ========================= */
input[type="checkbox"] {
    width: 4.8vh;
    height: 4.8vh;
    background-color: #241414;
    border-width: 0.25vh;
    border-color: #1f0000;
    box-shadow: 0px 2px 6px #050000;
    cursor: pointer;
    position: relative;
    vertical-align: middle;
    margin-right: 2vh;              /* consistent spacing with vh */
}

input[type="checkbox"]:checked {
    background-color: #cfa23a;      /* old gold accent */
    border-color: #cfa23a;
}


/* Force FXAA label to sit perfectly next to checkbox (overrides global label margin) */
input[type="checkbox"] + label {
    margin: 0;
    font-size: 4.0vh;
    color: #d1c6c6;
    vertical-align: middle;
    line-height: 4.8vh;
}