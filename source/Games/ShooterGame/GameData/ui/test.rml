<rml>
<head>
    <title>RmlUi Filter Test</title>

    <style>
        /* =========================
           Base layout
           ========================= */
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 5vh 5vw;
            box-sizing: border-box;

            background-color: #141414;
            color: #e0e0e0;

            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;

            font-family: "Kingthings Calligraphica 2";
        }

        /* =========================
           Header
           ========================= */
        h1 {
            margin: 0 0 3vh 0;
            font-size: 8vw;
            color: #f1c40f;

            font-effect: shadow(2px 2px #030301);
        }

        p {
            margin: 2vh 0 4vh 0;
            font-size: 3.2vw;
            color: #cccccc;

            font-effect: blur(10vh #ffffff);
        }

        label {
            margin: 3vh 0 1vh 0;
            font-size: 3.2vw;
            color: #dddddd;
        }

        /* =========================
           INPUT (FIXED — NO CLIPPING)
           ========================= */
        input[type="text"] {
            width: 80vw;
            max-width: 500px;

            /* FIX: horizontal padding + line-height */
            padding: 0px 0px;
            line-height: 1.4;

            /* FIX: use readable font for input */
            /*font-family: "Arial";*/
            font-size: 6vh;

            background-color: #1e2a36;
            color: #ffffff;

            border: 2px solid #3498db;
            border-radius: 10px;

            box-sizing: border-box;
            box-shadow: 0px 2px 6px #000000;
        }

        input[type="text"]:focus {
            border-color: #f39c12;
            font-effect: shadow(2px 2px #030301);
        }

        /* =========================
           Button
           ========================= */
        button {
            width: 60vw;
            max-width: 400px;

            margin-top: 4vh;
            padding: 12px 32px;

            font-size: 28px;
            font-family: "Kingthings Calligraphica 2";

            background-color: #2980b9;
            color: #ffffff;

            border: 2px solid #5dade2;
            border-radius: 12px;

            cursor: pointer;
            box-shadow: 0px 4px 8px #000000;

            font-effect: shadow(2px 2px #030301);
        }

        button:hover {
            background-color: #3498db;
            border-color: #f1c40f;
            box-shadow: 0px 2px 6px #000000;
        }
    </style>
</head>

<body>
    <h1>RmlUi Filter Test</h1>
    <p>If this text is blurred, filters are working.</p>

    <label for="username">Enter your name:</label>
    <input type="text" id="username" placeholder="Type something here..." />

    <button>Click Me</button>
</body>
</rml>
