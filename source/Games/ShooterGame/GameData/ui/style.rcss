

/* =========================
   Header
   ========================= */
h1 {
    margin: 0 0 3vh 0;
    font-size: 8vh;
    color: #cfa23a; /* old gold */
    font-effect: glow(2px 4px 2px 3px rgb(90, 20, 20));
}

p {
    margin: 2vh 0 4vh 0;
    font-size: 3.2vh;
    color: transparent;
    font-effect: blur(10vh #f5eaea);
}

label {
    margin: 3vh 0 1vh 0;
    font-size: 3.2vh;
    color: #d2bebe; /* ash */
}

/* =========================
   INPUT (GOTHIC RED)
   ========================= */
input[type="text"] {
    width: 80vh;
    max-width: 80vh;
    padding: 0px 0px;
    line-height: 1.4;
    font-size: 6vh;

    background-color: #241414; /* dark blood steel */
    color: #d1c6c6;

    box-sizing: border-box;
    box-shadow: 0px 2px 6px #050000;
}

input[type="text"]::placeholder {
    color: #8f6b6b;        /* muted ash-red */
    font-style: italic;   /* optional */
}


input[type="text"]:focus {
    border-color: #c0392b;
    font-effect: shadow(2px 2px #160000);
    tab-index: auto;
}



/* =========================
   Button
   ========================= */
button {
    padding: 0.5vh 1.5vh;
    font-size: 3vh;

    background-color: #4a1515; /* dried blood */
    color: #d1c6c6;

    border-radius: 0.2vh;
    border-color: #1f0000;
    cursor: pointer;

    border-width: 0.25vh;

    box-shadow: 0 0.5vh 1vh #050000;
    font-effect: shadow(0.2vh 0.2vh #120000);
    tab-index: auto;
    font-size: 4.0vh;

    display: inline-block;
    text-align: center;
    white-space: nowrap;

    margin: 0.1vh;

}

button:active {
    border-color: #cfa23a;
    box-shadow: 0px 2px 6px #050000;
}


