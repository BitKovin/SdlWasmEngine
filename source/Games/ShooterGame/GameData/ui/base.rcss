body {
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0vh;
    box-sizing: border-box;

    background-color: #350e0e7a; /* dark wine */
    color: #e6dede;            /* pale bone */

    

    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;

    nav: auto;
    font-family: "Kingthings Calligraphica 2";
}

input, button, select {
    nav: auto;
}


/* =========================
   Focus indicator
   ========================= */
.focus_wrapper {
    position: relative;
    display: inline-block;
}

.indicator {
    position: absolute;
    width: 1.8vh;
    height: 1.8vh;
    background-color: #c0392b; /* ember red */
    right: -2vh;
    top: 50%;
    visibility: hidden;
    transform: translateY(-50%);
    border-radius: 1vh;
}

/* show indicator on hover/focus */
.focus_wrapper *:hover ~ .indicator,
.focus_wrapper *:focus ~ .indicator {
    visibility: visible;
}