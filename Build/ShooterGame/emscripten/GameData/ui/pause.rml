<rml>
    <head>
        <title>Pause Menu</title>
        <link type="text/css" href="style.rcss" />
        <link type="text/css" href="base.rcss" />
    </head>

    <body data-title="Pause Menu">
        <h1>Pause Menu</h1>

        <div class="focus_wrapper">
            <button id="backBtn">Resume</button>
            <div class="indicator"></div>
        </div>

        <div class="focus_wrapper">
            <button id="saveBtn">Save Game</button>
            <div class="indicator"></div>
        </div>

        <div class="focus_wrapper">
            <button id="loadBtn">Load Game</button>
            <div class="indicator"></div>
        </div>

        <div class="focus_wrapper">
            <button id="optionsBtn">Options</button>
            <div class="indicator"></div>
        </div>

        <div class="focus_wrapper">
            <button id="mainMenuBtn">Main Menu</button>
            <div class="indicator"></div>
        </div>
    </body>
</rml>
