build sourceLibraries/SDL_ttf/CMakeFiles/install/local.util: CUSTOM_COMMAND sourceLibraries/SDL_ttf/all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D F:\Git\SdlWasmEngine\Build\sourceLibraries\SDL_ttf && "C:\Program Files\CMake\bin\cmake.exe" -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake"
  DESC = Installing only the local directory...
