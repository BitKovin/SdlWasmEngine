# =============================================================================
# Object build statements for STATIC_LIBRARY target SDL2_ttf


#############################################
# Order-only phony target for SDL2_ttf

build cmake_object_order_depends_target_SDL2_ttf: phony || cmake_object_order_depends_target_SDL2-static

build sourceLibraries/SDL_ttf/CMakeFiles/SDL2_ttf.dir/SDL_ttf.c.o: C_COMPILER__SDL2_ttf_unscanned_ F$:/Git/SdlWasmEngine/sourceLibraries/SDL_ttf/SDL_ttf.c || cmake_object_order_depends_target_SDL2_ttf
  DEFINES = -DBUILD_SDL -DSDL_BUILD_MAJOR_VERSION=2 -DSDL_BUILD_MICRO_VERSION=0 -DSDL_BUILD_MINOR_VERSION=24
  DEP_FILE = sourceLibraries\SDL_ttf\CMakeFiles\SDL2_ttf.dir\SDL_ttf.c.o.d
  FLAGS = -msse -msse2 -msimd128 -msse4.2 -fPIC -fvisibility=hidden -O2 -DNDEBUG
  INCLUDES = -IF:/Git/SdlWasmEngine/sourceLibraries/SDL_ttf -IF:/Git/SdlWasmEngine/Build/sourceLibraries/SDL/include -IF:/Git/SdlWasmEngine/Build/sourceLibraries/SDL/include/SDL2 -IF:/Git/SdlWasmEngine/Build/sourceLibraries/SDL/include-config-/SDL2 -isystem F:/Tools/emsdk/upstream/emscripten/cache/sysroot/include/freetype2
  OBJECT_DIR = sourceLibraries\SDL_ttf\CMakeFiles\SDL2_ttf.dir
  OBJECT_FILE_DIR = sourceLibraries\SDL_ttf\CMakeFiles\SDL2_ttf.dir


# =============================================================================
# Link build statements for STATIC_LIBRARY target SDL2_ttf


#############################################
# Link the static library sourceLibraries\SDL_ttf\libSDL2_ttf.a

build sourceLibraries/SDL_ttf/libSDL2_ttf.a: C_STATIC_LIBRARY_LINKER__SDL2_ttf_ sourceLibraries/SDL_ttf/CMakeFiles/SDL2_ttf.dir/SDL_ttf.c.o || sourceLibraries/SDL/libSDL2.a
  LANGUAGE_COMPILE_FLAGS = -msse -msse2 -msimd128 -msse4.2
  OBJECT_DIR = sourceLibraries\SDL_ttf\CMakeFiles\SDL2_ttf.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_FILE = sourceLibraries\SDL_ttf\libSDL2_ttf.a
  TARGET_PDB = SDL2_ttf.a.dbg


#############################################
# Utility command for edit_cache

build sourceLibraries/SDL_ttf/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D F:\Git\SdlWasmEngine\Build\sourceLibraries\SDL_ttf && "C:\Program Files\CMake\bin\cmake-gui.exe" -SF:\Git\SdlWasmEngine -BF:\Git\SdlWasmEngine\Build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build sourceLibraries/SDL_ttf/edit_cache: phony sourceLibraries/SDL_ttf/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build sourceLibraries/SDL_ttf/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D F:\Git\SdlWasmEngine\Build\sourceLibraries\SDL_ttf && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SF:\Git\SdlWasmEngine -BF:\Git\SdlWasmEngine\Build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build sourceLibraries/SDL_ttf/rebuild_cache: phony sourceLibraries/SDL_ttf/CMakeFiles/rebuild_cache.util


