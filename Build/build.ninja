# Utility command for list_install_components

build sourceLibraries/SDL_ttf/list_install_components: phony


#############################################
# Utility command for install

build sourceLibraries/SDL_ttf/CMakeFiles/install.util: CUSTOM_COMMAND sourceLibraries/SDL_ttf/all
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D F:\Git\SdlWasmEngine\Build\sourceLibraries\SDL_ttf && "C:\Program Files\CMake\bin\cmake.exe" -P cmake_install.cmake"
  DESC = Install the project...
  pool = console
  restat = 1

build sourceLibraries/SDL_ttf/install: phony sourceLibraries/SDL_ttf/CMakeFiles/install.util


