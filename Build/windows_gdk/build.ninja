build CMakeFiles\package_source.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D F:\Git\SdlWasmEngine\Build\windows_gdk && "C:\Program Files\CMake\bin\cpack.exe" --config ./CPackSourceConfig.cmake F:/Git/SdlWasmEngine/Build/windows_gdk/CPackSourceConfig.cmake"
