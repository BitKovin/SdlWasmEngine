      ],
      "description": "Generic placeholder for inserting models to map. Model triangles are baked to BSP.\n        MD3, ASE, 3DS, OBJ, FM, LWO, MD2, MDC, MS3D model formats are supported.\n        -------- Q3MAP2 KEYS -------- -------- SPAWNFLAGS -------- other possible modes of clipping:\n        CLIPMODEL\u002BAXIAL_BACKPLANE\n        EXTRUDE_FACE_NORMALS\u002BPYRAMIDAL_CLIP - truncated pyramid with 45 degrees sides\n        EXTRUDE_TERRAIN\u002BMAX_EXTRUDE\n        EXTRUDE_TERRAIN\u002BAXIAL_BACKPLANE\n        EXTRUDE_VERTEX_NORMALS \u002B PYRAMIDAL_CLIP - vertex normals mode: don\u0027t check for sides, sticking outwards\n        PYRAMIDAL_CLIP\u002BAXIAL_BACKPLANE - pyramid with 3 of 4 sides axial (-\u003Esmall bsp)\n        EXTRUDE_DOWNWARDS\u002BEXTRUDE_UPWARDS\n        EXTRUDE_DOWNWARDS\u002BMAX_EXTRUDE\n        EXTRUDE_DOWNWARDS\u002BAXIAL_BACKPLANE\n        EXTRUDE_DOWNWARDS\u002BEXTRUDE_UPWARDS\u002BMAX_EXTRUDE\n        EXTRUDE_DOWNWARDS\u002BEXTRUDE_UPWARDS\u002BAXIAL_BACKPLANE\n        EXTRUDE_UPWARDS\u002BMAX_EXTRUDE\n        EXTRUDE_UPWARDS\u002BAXIAL_BACKPLANE",
      "inherits": [],
      "properties": [
        {
          "key": "model",
          "displayName": "Model File",
          "type": "Model",
          "defaultValue": "",
          "description": "Path/name of model to use (e.g. models/mapobjects/teleporter/teleporter.md3).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "angle",
          "displayName": "Yaw Angle",
          "type": "Angle",
          "defaultValue": "",
          "description": "Direction in which model will be oriented.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "angles",
          "displayName": "Pitch Yaw Roll",
          "type": "Angles",
          "defaultValue": "",
          "description": "Individual control of PITCH, YAW, and ROLL (default 0 0 0).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "modelscale",
          "displayName": "Uniform Scale",
          "type": "Real",
          "defaultValue": "1",
          "description": "Floating-point value used to scale a model up or down (default 1.0).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "modelscale_vec",
          "displayName": "Scale XYZ",
          "type": "Real3",
          "defaultValue": "1 1 1",
          "description": "Floating-point vector used to scale a model\u0027s axes individually (default 1.0 1.0 1.0).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_remap",
          "displayName": "Shader Remaps",
          "type": "Array",
          "defaultValue": "",
          "description": "Used to remap textures/shaders in the model. To remap all shaders to a given shader, use \u0022*;models/mymodel/mytexture\u0022. To remap a specific shader, use \u0022models/mymodel/old;models/mymodel/new\u0022. Any key starting with _remap prefix will work, so if you need more remappings, create _remap2, _remap3 etc keys.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "target",
          "displayName": "Target",
          "type": "Target",
          "defaultValue": "",
          "description": "Used to attach the misc_model to a brush entity, where its \u0022targetname\u0022 key is the same value.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_lightmapscale",
          "displayName": "Lightmap Scale",
          "type": "Real",
          "defaultValue": "1",
          "description": "Floating point value, scaling the resolution of lightmaps on this model (if model is using lightmapped shaders) (default 1.0).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_castshadows",
          "displayName": "Shadow Caster Level",
          "type": "Integer",
          "defaultValue": "1",
          "description": "Allows per-entity control over shadow casting. Defaults to 0 on entities, 1 on world. 0 = no shadow casting. 1 = cast shadows on world. \u003E 1 = cast shadows on entities with _rs (or _receiveshadows) with the corresponding value, AND world. Negative values imply same, but DO NOT cast shadows on world.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_receiveshadows",
          "displayName": "Shadow Receiver Level",
          "type": "Integer",
          "defaultValue": "1",
          "description": "Allows per-entity control over shadow reception. Defaults to 1 on everything (world shadows). 0 = receives NO shadows. \u003E 1 = receive shadows only from corresponding keyed entities (see above) and world. \u003C 1 = receive shadows ONLY from corresponding keyed entities.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_celshader",
          "displayName": "Cel Shader",
          "type": "Texture",
          "defaultValue": "",
          "description": "Sets the cel shader used for this geometry. Note: Omit the \u0022textures/\u0022 prefix.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_clipdepth",
          "displayName": "Autoclip thickness",
          "type": "Real",
          "defaultValue": "2",
          "description": "Autoclip brushes thickness (default 2.0).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_RMG_BSP",
          "displayName": "_RMG_BSP",
          "type": "Flag",
          "defaultValue": "",
          "description": "in SoF2, append a _RMG_BSP suffix to shader names instead of _BSP",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "CLIPMODEL",
          "displayName": "Clip Model",
          "type": "Flag",
          "defaultValue": "",
          "description": "Clips the model for player/weapon collisions; extruding every face along most perpendicular axial direction. For use on large architectural or terrain models, not for small decorative models.",
          "bitIndex": 1,
          "isBuiltIn": false
        },
        {
          "key": "FORCEMETA",
          "displayName": "Force Meta",
          "type": "Flag",
          "defaultValue": "",
          "description": "Toggles on q3map_forceMeta for lightmapped models. Converts model triangles to bsp metasurfaces.",
          "bitIndex": 2,
          "isBuiltIn": false
        },
        {
          "key": "EXTRUDE_FACE",
          "displayName": "EXTRUDE_FACE_NORMALS",
          "type": "Flag",
          "defaultValue": "",
          "description": "extrude along the model face normals for clipping",
          "bitIndex": 3,
          "isBuiltIn": false
        },
        {
          "key": "EXTRUDE_TERRAIN",
          "displayName": "EXTRUDE_TERRAIN",
          "type": "Flag",
          "defaultValue": "",
          "description": "extrude each surface of the model along its average axial direction ( up/down/west/east/north/south ); faces with not matching direction (or too steep) are clipped in default mode",
          "bitIndex": 4,
          "isBuiltIn": false
        },
        {
          "key": "COLOR_TO_ALPHA",
          "displayName": "COLOR_TO_ALPHA",
          "type": "Flag",
          "defaultValue": "",
          "description": "use the color value as alpha (for terrain blending)",
          "bitIndex": 5,
          "isBuiltIn": false
        },
        {
          "key": "EXTRUDE_VERTEX",
          "displayName": "EXTRUDE_VERTEX_NORMALS",
          "type": "Flag",
          "defaultValue": "",
          "description": "extrude along the model vertex normals for clipping; accurate collisions, if normals are fine; bad ones are replaced with 45 degrees to face",
          "bitIndex": 7,
          "isBuiltIn": false
        },
        {
          "key": "PYRAMIDAL_CLIP",
          "displayName": "PYRAMIDAL_CLIP",
          "type": "Flag",
          "defaultValue": "",
          "description": "pyramidal clipping brushes (4-sided); accurate collisions",
          "bitIndex": 8,
          "isBuiltIn": false
        },
        {
          "key": "EXTRUDE_DOWN",
          "displayName": "EXTRUDE_DOWNWARDS",
          "type": "Flag",
          "defaultValue": "",
          "description": "for horizontal terrain; when not possible, extrude in default mode",
          "bitIndex": 9,
          "isBuiltIn": false
        },
        {
          "key": "EXTRUDE_UP",
          "displayName": "EXTRUDE_UPWARDS",
          "type": "Flag",
          "defaultValue": "",
          "description": "-//-",
          "bitIndex": 10,
          "isBuiltIn": false
        },
        {
          "key": "MAX_EXTRUDE",
          "displayName": "MAX_EXTRUDE",
          "type": "Flag",
          "defaultValue": "",
          "description": "Extrude to the max/min point of every model surface to reduce bsp size (uses axial back plane)",
          "bitIndex": 11,
          "isBuiltIn": false
        },
        {
          "key": "AXIAL_BACKPLANE",
          "displayName": "AXIAL_BACKPLANE",
          "type": "Flag",
          "defaultValue": "",
          "description": "use axial back plane for clipping brushes to effectively reduce bsp size; might cause unwanted collisions, make sure to -debugclip; negative _clipdepth / -clipdepth limits max thickness of resulting brushes (making non-axial backplane, if hit the limit)",
          "bitIndex": 12,
          "isBuiltIn": false
        }
      ]
    },
