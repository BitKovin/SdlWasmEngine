        16
      ],
      "description": "Entity, which stores regular static map primitives (brushes and patches).\n\t\t-------- KEYS -------- -------- Q3MAP2 KEYS -------- Overridable in entities. -------- Q3MAP2 TERRAIN KEYS --------",
      "inherits": [],
      "properties": [
        {
          "key": "message",
          "displayName": "Logon Message",
          "type": "String",
          "defaultValue": "",
          "description": "Text to print at user logon. Used for name of level.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "music",
          "displayName": "Music File",
          "type": "Sound",
          "defaultValue": "",
          "description": "Path/name of looping .wav file used for level\u0027s music (e.g. music/sonic5.wav). Specifying two files, like \u0027music/fla22k_04_intro.wav music/fla22k_04_loop.wav\u0027 will make former to play once and latter looped then.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "gravity",
          "displayName": "Gravity",
          "type": "Real",
          "defaultValue": "800",
          "description": "Gravity of level (default normal gravity: 800).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "gridsize",
          "displayName": "Dynamic Light Granularity",
          "type": "Integer",
          "defaultValue": "64 64 128",
          "description": "Granularity of the lightgrid, created by q3map, which is used to dynamically light certain game objects, like players and items. Value is three integers separated by spaces, representing number of units between grid points in X Y Z. Default gridsize value is 64 64 128. Use larger powers of 2 to reduce BSP size and compile time on very large maps.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_blocksize",
          "displayName": "BSP Block Size",
          "type": "Integer",
          "defaultValue": "1024 1024 1024",
          "description": "Map compiler splits the BSP tree along axial planes (X, Y and Z) for optimization. It does it as often, as specified in _blocksize key for respective axis (in units) (default 1024 1024 1024, 0 = disable, setting single value \u0027N\u0027 equals to setting \u0027N N N\u0027). I.e. lower values result in more splits and vice versa. Increase the blocksize using larger powers of 2 to reduce compile times on very large maps with a low structural brush density. Maps, having flat architecture, might work better with horizontal splits disabled (\u0027N N 0\u0027).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_ambient",
          "displayName": "Ambient Intensity",
          "type": "Real",
          "defaultValue": "0",
          "description": "Adds a constant value to overall lighting (default 0, range 0 - 255). Only recommended use is small values for cosmetic purposes, as high values will have a tendency to flatten out variations in light and shade.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_color",
          "displayName": "Ambient Color",
          "type": "Color",
          "defaultValue": "1 1 1",
          "description": "RGB color value for ambient and other global light parameters (default is 1 1 1).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_minlight",
          "displayName": "Min Lightmap Intensity",
          "type": "Real",
          "defaultValue": "0",
          "description": "Minimum light value, levelwide. Uses the _color key to set color. Since it does not add unlike ambient, but overrides existing light values, affected areas will get flat constant light. Therefore use is highly not recommended!",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_minvertexlight",
          "displayName": "Min Vertex Intensity",
          "type": "Real",
          "defaultValue": "0",
          "description": "Minimum vertex lighting, levelwide.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_mingridlight",
          "displayName": "Min Dynamic Intensity",
          "type": "Real",
          "defaultValue": "0",
          "description": "Minimum lightgrid (dynamic entity lighting) levelwide.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_floodlight",
          "displayName": "FloodLight",
          "type": "String",
          "defaultValue": "240 240 255 1024 128 1",
          "description": "A sextet of values \u0022r g b dist intensity directional_power\u0022 to set global floodlight parameters (good defaults are 240 240 255 1024 128 1). Floodlight effect is sort of Ambient Occlusion.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_keeplights",
          "displayName": "Keep Light Entities",
          "type": "Boolean",
          "defaultValue": "",
          "description": "Keep light entities in the BSP. Normally stripped out by the BSP process and read from the .map file by the lighting phase.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_noshadersun",
          "displayName": "Ignore Shader Sun",
          "type": "Boolean",
          "defaultValue": "",
          "description": "Ignore q3map_sun/sun directives in sky shaders and ONLY use entity sun lights.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_farplanedist",
          "displayName": "Far Clip Distance",
          "type": "Real",
          "defaultValue": "",
          "description": "Limit on how many units the vis phase of compilation can see. Used in combination with level-wide fog, it can help reduce r_speeds on large, open maps.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_foghull",
          "displayName": "Fog Hull Shader",
          "type": "Texture",
          "defaultValue": "",
          "description": "Shader to use for \u0022fog hull\u0022. Foghull shader should be a sky shader. Omit the \u0022textures/\u0022 prefix.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_lightmapscale",
          "displayName": "Lightmap Scale",
          "type": "Real",
          "defaultValue": "1",
          "description": "Floating point value, scaling the resolution of lightmaps on brushes/patches in the world. Can be overridden in func_group (or other entities) (default 1.0).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_castshadows",
          "displayName": "Shadow Caster Level",
          "type": "Integer",
          "defaultValue": "1",
          "description": "Allows per-entity control over shadow casting. Defaults to 0 on entities, 1 on world. 0 = no shadow casting. 1 = cast shadows on world. \u003E 1 = cast shadows on entities with _rs (or _receiveshadows) with the corresponding value, AND world. Negative values imply same, but DO NOT cast shadows on world.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_receiveshadows",
          "displayName": "Shadow Receiver Level",
          "type": "Integer",
          "defaultValue": "1",
          "description": "Allows per-entity control over shadow reception. Defaults to 1 on everything (world shadows). 0 = receives NO shadows. \u003E 1 = receive shadows only from corresponding keyed entities (see above) and world. \u003C 1 = receive shadows ONLY from corresponding keyed entities.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_celshader",
          "displayName": "Cel Shader",
          "type": "Texture",
          "defaultValue": "",
          "description": "Sets the cel shader used for this geometry. Note: Omit the \u0022textures/\u0022 prefix.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_styleNalphaGen",
          "displayName": "Style Light alphaGen",
          "type": "String",
          "defaultValue": "",
          "description": "*IMPORTANT* Replace \u0022N\u0022 in the key \u0022_styleNalphaGen\u0022 with an integer between 1 and 31 as your style index. Values takes standard shader waveform functions (e.g. wave sin 0.5 0.3 0.25 1.5)",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_styleNrgbGen",
          "displayName": "Style Light rgbGen",
          "type": "String",
          "defaultValue": "",
          "description": "*IMPORTANT* Replace \u0022N\u0022 in the key \u0022_styleNrgbGen\u0022 with an integer between 1 and 31 as your style index. Values take standard shader waveform functions (e.g. wave sin 0.5 0.3 0.25 1.5)",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_indexmap",
          "displayName": "Terrain Blending Map",
          "type": "Texture",
          "defaultValue": "",
          "description": "Path/name for the art file used to guide the mapping of textures on the terrain surface.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_layers",
          "displayName": "Terrain Layers",
          "type": "Integer",
          "defaultValue": "",
          "description": "Number of unique root shaders that will be used on the terrain.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_shader",
          "displayName": "Terrain MetaShader",
          "type": "Texture",
          "defaultValue": "",
          "description": "Path to the metashader used to assign textures to the terrain entity. Note: Omit the \u0022textures/\u0022 prefix.",
          "bitIndex": 0,
          "isBuiltIn": false
        }
      ]
    },
