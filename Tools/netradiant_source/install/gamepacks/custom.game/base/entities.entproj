        1
      ],
      "box": [
        -8,
        -8,
        -8,
        8,
        8,
        8
      ],
      "description": "Non-displayed point light source. The -pointscale and -scale arguments to Q3Map2 affect the brightness of these lights. The -skyscale argument affects brightness of entity sun lights.\n\t\t-------- Q3MAP2 KEYS -------- -------- SPAWNFLAGS --------",
      "inherits": [],
      "properties": [
        {
          "key": "light",
          "displayName": "Light Intensity",
          "type": "Real",
          "defaultValue": "300",
          "description": "Overrides the default 300 intensity. Negative values may be used for negative lights.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_color",
          "displayName": "Light Color",
          "type": "Color",
          "defaultValue": "1 1 1",
          "description": "Weighted RGB value of light color (default 1.0 1.0 1.0 = white).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "target",
          "displayName": "Target",
          "type": "Target",
          "defaultValue": "",
          "description": "Lights pointed at a target (info_null / target_position) will be spotlights.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "radius",
          "displayName": "Spotlight Radius",
          "type": "Real",
          "defaultValue": "64",
          "description": "Overrides the default 64 unit radius of a spotlight at the target point.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_sun",
          "displayName": "Sun",
          "type": "Boolean",
          "defaultValue": "",
          "description": "Set this key to 1 on a spotlight to make an infinite sun light.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "fade",
          "displayName": "Linear Fade",
          "type": "Real",
          "defaultValue": "1",
          "description": "Fades light attenuation. Only affects linear lights.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "scale",
          "displayName": "Intensity Scale",
          "type": "Real",
          "defaultValue": "1",
          "description": "Scales the \u0022light\u0022 value.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_deviance",
          "displayName": "Penumbra Deviance",
          "type": "Real",
          "defaultValue": "0",
          "description": "Penumbra effect - distance measured in world units for point/spot lights, and degrees for suns (~0.5-3).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_samples",
          "displayName": "Penumbra Samples",
          "type": "Integer",
          "defaultValue": "1",
          "description": "Penumbra effect - the number of random jitters distributed over the solid arc (~16).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_filter",
          "displayName": "Lightmap Filtering",
          "type": "Boolean",
          "defaultValue": "",
          "description": "Set this key to 1 to toggle on lightmap filtering.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_filterradius",
          "displayName": "Filter Radius",
          "type": "Real",
          "defaultValue": "",
          "description": "Filters lightmaps within set radius.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_anglescale",
          "displayName": "Light Attenuation Scale",
          "type": "Real",
          "defaultValue": "1",
          "description": "Scales light attenuation. Smaller values lessens angle attenuation, larger values for sharper, more faceted lighting (default 1.0).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "style",
          "displayName": "Light Style Index",
          "type": "Integer",
          "defaultValue": "",
          "description": "Light style index number associated with worldspawn light style. Values are between 1 and 31.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "LINEAR",
          "displayName": "Linear Falloff",
          "type": "Flag",
          "defaultValue": "",
          "description": "Use a linear falloff. Default is inverse distance squared (more realistic).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "NOANGLE",
          "displayName": "No Angle Attenuation",
          "type": "Flag",
          "defaultValue": "",
          "description": "Ignore angle attenuation.",
          "bitIndex": 1,
          "isBuiltIn": false
        },
        {
          "key": "NOGRIDLIGHT",
          "displayName": "Not Dynamic",
          "type": "Flag",
          "defaultValue": "",
          "description": "Do not affect the lightgrid (dynamic entity lighting).",
          "bitIndex": 4,
