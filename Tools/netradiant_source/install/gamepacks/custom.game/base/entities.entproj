    {
      "name": "func_group",
      "entityType": "group",
      "color": [
        0,
        0.4375,
        0.7
      ],
      "box": [
        -16,
        -16,
        -16,
        16,
        16,
        16
      ],
      "description": "This is not an entity as such. It is strictly an editor utility to group world brushes and patches together for convenience (selecting, moving, copying, applying special compilation parameters etc). You cannot group entities with this. Func_group contents is merged into worldspawn entity during compilation process. -------- Q3MAP2 KEYS -------- -------- Q3MAP2 TERRAIN KEYS -------- -------- NOTES --------\nTo make a func_group into a terrain entity, refer to the Terrain Construction documentation.",
      "inherits": [],
      "properties": [
        {
          "key": "_lightmapscale",
          "displayName": "Lightmap Scale",
          "type": "Real",
          "defaultValue": "1",
          "description": "Floating point value, scaling the resolution of lightmaps on brushes/patches in this entity (default 1.0).",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_castshadows",
          "displayName": "Shadow Caster Level",
          "type": "Integer",
          "defaultValue": "1",
          "description": "Allows per-entity control over shadow casting. Defaults to 0 on entities, 1 on world. 0 = no shadow casting. 1 = cast shadows on world. \u003E 1 = cast shadows on entities with _rs (or _receiveshadows) with the corresponding value, AND world. Negative values imply same, but DO NOT cast shadows on world.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_receiveshadows",
          "displayName": "Shadow Receiver Level",
          "type": "Integer",
          "defaultValue": "1",
          "description": "Allows per-entity control over shadow reception. Defaults to 1 on everything (world shadows). 0 = receives NO shadows. \u003E 1 = receive shadows only from corresponding keyed entities (see above) and world. \u003C 1 = receive shadows ONLY from corresponding keyed entities.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_celshader",
          "displayName": "Cel Shader",
          "type": "Texture",
          "defaultValue": "",
          "description": "Sets the cel shader used for this geometry. Note: Omit the \u0022textures/\u0022 prefix.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_indexmap",
          "displayName": "Terrain Blending Map",
          "type": "Texture",
          "defaultValue": "",
          "description": "Path/name for the art file used to guide the mapping of textures on the terrain surface.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_layers",
          "displayName": "Terrain Layers",
          "type": "Integer",
          "defaultValue": "",
          "description": "Number of unique root shaders that will be used on the terrain.",
          "bitIndex": 0,
          "isBuiltIn": false
        },
        {
          "key": "_shader",
          "displayName": "Terrain MetaShader",
          "type": "Texture",
          "defaultValue": "",
          "description": "Path to the metashader used to assign textures to the terrain entity. Note: Omit the \u0022textures/\u0022 prefix.",
          "bitIndex": 0,
          "isBuiltIn": false
        }
      ]
    },
