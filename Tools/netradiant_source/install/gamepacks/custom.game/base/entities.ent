        <real key="modelscale" name="Uniform Scale" value="48">Will by scaled by 32 in engine.</real>
        <string key="classname" name="Classname" value="item_weapon_cane">The classname of the entity.</string>
        <string key="targetname" name="Name" />
        <target key="target" name="Target">Targetname of entity to activate/target.</target>
        <string key="onPickupEvent" name="On Pickup" />
        <angle key="angle" name="Yaw Angle" value="0">Yaw rotation in degrees. 0 = East, 90 = South, etc.</angle>
        <angles key="angles" name="Pitch Yaw Roll" value="0 0 0">Full rotation: Pitch Yaw Roll in degrees.</angles>
        <integer key="spawnflags" name="Spawnflags" value="0">Bitmask of spawning flags.</integer>
        <flag key="no_dificuly_easy" name="Don't spawn on Easy" bit="0" />
